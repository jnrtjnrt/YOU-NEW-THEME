{% comment %}
  Serializes one product into the compact JSON shape the Style Lab builder
  and bundles carousel JS expect: id/title/url/image, its color option
  (if any) with resolved swatch hex values, and a reduced variants array
  for client-side variant resolution + pricing.
  Usage: {% render 'style-lab-product-json', for_product: product %}
{% endcomment %}
{%- liquid
  assign color_option = blank
  for option in for_product.options_with_values
    assign opt_name = option.name | downcase
    if opt_name == 'color' or opt_name == 'colour'
      assign color_option = option
      break
    endif
  endfor
-%}
{
  "id": {{ for_product.id }},
  "title": {{ for_product.title | json }},
  "url": {{ for_product.url | json }},
  "image": {{ for_product.featured_media | image_url: width: 800 | json }},
  "colorPosition": {{ color_option.position | default: 0 }},
  "colors": [
    {%- if color_option != blank -%}
      {%- for value in color_option.values -%}
        {%- liquid
          capture value_title
            echo value
          endcapture
          capture hex
            render 'swatch-style', value: value
          endcapture
          capture color_media_json
            render 'product-color-media', for_product: for_product, color_position: color_option.position, value: value_title
          endcapture
        -%}
        { "value": {{ value_title | json }}, "hex": {{ hex | strip | json }}, "media": {{ color_media_json | strip }} }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    {%- endif -%}
  ],
  "variants": [
    {%- for variant in for_product.variants -%}
      {
        "id": {{ variant.id }},
        "options": {{ variant.options | json }},
        "available": {{ variant.available }},
        "price": {{ variant.price }},
        "price_formatted": {{ variant.price | money | json }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
