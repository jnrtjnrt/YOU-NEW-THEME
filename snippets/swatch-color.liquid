{% comment %}
  Resolves an option value name to a CSS color using the
  "Custom swatch colors" mapping in Theme settings > Product cards.
  Usage: {% render 'swatch-color', value: 'Volt' %}
  Outputs a CSS color string (falls back to the value itself,
  which works for plain names like "black" or "pink").
{% endcomment %}
{%- liquid
  assign resolved = value | downcase
  assign rows = settings.swatch_colors | newline_to_br | split: '<br />'
  for row in rows
    assign parts = row | strip | split: ':'
    assign row_name = parts[0] | strip | downcase
    if row_name == resolved and parts.size > 1
      assign resolved = parts[1] | strip
      break
    endif
  endfor
-%}{{ resolved }}
