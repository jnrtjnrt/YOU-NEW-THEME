{% comment %}
  Recently viewed products, tracked client-side via localStorage (no app
  required). Hides itself automatically when there's nothing to show yet.
{% endcomment %}
<div style="padding: {{ section.settings.padding }}px 0;" data-recently-viewed data-current-handle="{{ product.handle }}" data-max-items="{{ section.settings.max_items }}" hidden>
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading" style="font-size: calc(32px * var(--heading-scale)); margin-bottom: 32px;">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="grid grid--4" data-recently-viewed-row></div>
  </div>
</div>

{% schema %}
{
  "name": "Recently viewed",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently Viewed" },
    { "type": "range", "id": "max_items", "label": "Maximum products", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 0, "max": 128, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [
    { "name": "Recently viewed" }
  ],
  "enabled_on": {
    "templates": ["product", "index", "collection"]
  }
}
{% endschema %}
