{% comment %}
  Generic inline CTA banner for product templates — e.g. the "Too Lazy To
  Pick A Strap? Check our bundles" reminder on the Bag PDP. Reusable for any
  short upsell message + single button.
{% endcomment %}
<div style="max-width: var(--container-max); margin: 0 auto; padding: {{ section.settings.padding_top }}px {{ section.settings.padding_side }}px {{ section.settings.padding_bottom }}px {{ section.settings.padding_side }}px;">
  <div class="product-upsell-banner" style="background: {{ section.settings.background }}; color: {{ section.settings.text_color }};">
    <div class="product-upsell-banner__copy">
      {%- if section.settings.heading != blank -%}
        <h2 class="product-upsell-banner__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="product-upsell-banner__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button" style="background: {{ section.settings.button_background }}; color: {{ section.settings.button_text_color }}; flex-shrink: 0;">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} .product-upsell-banner {
    padding: 48px; display: flex; align-items: center; justify-content: space-between; gap: 32px; flex-wrap: wrap;
  }
  #shopify-section-{{ section.id }} .product-upsell-banner__copy { flex: 1; min-width: 260px; }
  #shopify-section-{{ section.id }} .product-upsell-banner__heading { font-size: calc(32px * var(--heading-scale)); margin: 0 0 8px 0; }
  #shopify-section-{{ section.id }} .product-upsell-banner__text { font-size: 15px; margin: 0; }
</style>

{% schema %}
{
  "name": "Product upsell banner",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Too Lazy To Pick A Strap?" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Some bags already come matched with a strap in a bundle. Check if this one's in there.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SEE BUNDLES" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background", "label": "Background", "default": "#D4E84A" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1A1A1A" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#1A1A1A" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FDFEFF" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_side", "label": "Side padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [
    { "name": "Product upsell banner" }
  ],
  "enabled_on": {
    "templates": ["product", "index", "collection"]
  }
}
{% endschema %}
