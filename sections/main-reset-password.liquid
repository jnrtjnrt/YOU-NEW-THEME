<div class="customer container" style="padding-top: 48px; padding-bottom: 64px;">
  <h1>{{ 'customer.reset_password.title' | t }}</h1>
  {% form 'reset_customer_password' %}
    {%- if form.errors -%}
      <div class="form-status form-status--error">
        <ul>
          {%- for field in form.errors -%}
            <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
    <div class="field">
      <label for="ResetPassword">{{ 'customer.fields.password' | t }}</label>
      <input type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required>
    </div>
    <div class="field">
      <label for="ResetPasswordConfirm">{{ 'customer.fields.password_confirm' | t }}</label>
      <input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required>
    </div>
    <div class="customer__actions">
      <button type="submit" class="button">{{ 'customer.reset_password.submit' | t }}</button>
    </div>
  {% endform %}
</div>

{% schema %}
{
  "name": "Reset password",
  "tag": "section",
  "settings": []
}
{% endschema %}
