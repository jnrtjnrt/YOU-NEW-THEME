<div style="background: {{ section.settings.background }}; color: {{ section.settings.text_color }}; padding: {{ section.settings.padding }}px 0;">
  <div class="container" style="text-align: {{ section.settings.alignment }};">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'eyebrow' -%}
          <span class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        {%- when 'heading' -%}
          <h2 style="font-size: calc({{ block.settings.size }}px * var(--heading-scale)); margin: 8px 0 0 0;" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
        {%- when 'text' -%}
          <div class="rte" style="margin-top: 16px; {% if section.settings.alignment == 'center' %}margin-left: auto; margin-right: auto;{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          <div style="margin-top: 32px;" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: routes.root_url }}" class="button{% if block.settings.style == 'primary' %} button--primary{% elsif block.settings.style == 'secondary' %} button--secondary{% endif %}">{{ block.settings.label }}</a>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#FDFEFF" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1A1A1A" },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 0, "max": 128, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "MADE BY YOU" }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Heading", "default": "Talk about your brand" },
        { "type": "range", "id": "size", "label": "Size", "min": 24, "max": 96, "step": 4, "unit": "px", "default": 48 }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share information about your brand with your customers.</p>" }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "SHOP NOW" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "accent", "label": "Accent" },
            { "value": "primary", "label": "Primary (black)" },
            { "value": "secondary", "label": "Secondary (light)" }
          ],
          "default": "accent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rich text",
      "blocks": [
        { "type": "heading" },
        { "type": "text" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
