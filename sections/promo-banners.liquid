<div class="grid promo-banners__grid" style="grid-template-columns: repeat({{ section.blocks.size | at_most: 2 | at_least: 1 }}, 1fr); gap: 0;">
  {%- for block in section.blocks -%}
    {%- assign overlay_rgb = block.settings.overlay_color | color_to_rgb | remove: 'rgb(' | remove: ')' -%}
    <div style="position: relative; height: {{ section.settings.height }}px; background: {{ block.settings.overlay_color }}; overflow: hidden;" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        <img
          src="{{ block.settings.image | image_url: width: 1100 }}"
          srcset="{{ block.settings.image | image_url: width: 750 }} 750w, {{ block.settings.image | image_url: width: 1100 }} 1100w, {{ block.settings.image | image_url: width: 1500 }} 1500w"
          sizes="(min-width: 990px) 50vw, 100vw"
          alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.85; transition: transform var(--dur-med) var(--ease-snap);"
          class="promo-banner__image">
      {%- endif -%}
      <div style="position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; padding: 56px; background: linear-gradient(90deg, rgba({{ overlay_rgb }}, 0.9) 0%, rgba({{ overlay_rgb }}, 0.6) 55%, rgba({{ overlay_rgb }}, 0.1) 100%);">
        {%- if block.settings.heading != blank -%}
          <h3 style="font-size: calc({{ section.settings.heading_size }}px * var(--heading-scale)); color: {{ block.settings.text_color }}; margin: 0 0 24px 0;">{{ block.settings.heading }}</h3>
        {%- endif -%}
        {%- if block.settings.button_label != blank -%}
          <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="button button--secondary">{{ block.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</div>

<style>
  #shopify-section-{{ section.id }} .promo-banners__grid > div:hover .promo-banner__image { transform: scale(var(--card-hover-scale)); }
  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .promo-banners__grid { grid-template-columns: 1fr !important; }
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .promo-banners__grid > div { height: {{ section.settings.height | times: 0.75 | round }}px !important; }
    #shopify-section-{{ section.id }} .promo-banners__grid > div > div { padding: 28px var(--gutter) !important; }
    #shopify-section-{{ section.id }} h3 { font-size: clamp(22px, calc(14px + 4vw), calc({{ section.settings.heading_size | times: 0.75 | round }}px * var(--heading-scale))) !important; }
  }
</style>

{% schema %}
{
  "name": "Promo banners",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "height", "label": "Banner height", "min": 280, "max": 640, "step": 20, "unit": "px", "default": 480 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 64, "step": 2, "unit": "px", "default": 38 }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "color", "id": "overlay_color", "label": "Color wash", "default": "#2B6BE6" },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#FDFEFF" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Straps? Pick a bag first." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "MIX IT UP THEN" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    {
      "name": "Promo banners",
      "blocks": [
        { "type": "banner" },
        { "type": "banner", "settings": { "overlay_color": "#E535AB", "heading": "Too Lazy? Bundle It.", "button_label": "STOP OVERTHINKING IT" } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
