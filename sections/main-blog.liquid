<div class="container" style="padding-top: 48px; padding-bottom: 64px;">
  <h1 class="page-title">{{ blog.title }}</h1>

  {%- paginate blog.articles by section.settings.articles_per_page -%}
    {%- if blog.articles.size > 0 -%}
      <div class="grid grid--3">
        {%- for article in blog.articles -%}
          <a href="{{ article.url }}" class="article-card">
            <div class="article-card__media">
              {%- if article.image -%}
                <img src="{{ article.image | image_url: width: 640 }}" alt="{{ article.image.alt | escape }}" loading="lazy" width="{{ article.image.width }}" height="{{ article.image.height }}">
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            {%- if section.settings.show_date -%}
              <span class="article-card__meta">{{ article.published_at | date: format: 'abbreviated_date' }}</span>
            {%- endif -%}
            <h2 class="article-card__title">{{ article.title }}</h2>
            {%- if section.settings.show_excerpt -%}
              <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="section-subtext">{{ 'blogs.empty' | t }}</p>
    {%- endif -%}

    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "articles_per_page", "label": "Posts per page", "min": 3, "max": 24, "step": 3, "default": 9 },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true }
  ]
}
{% endschema %}
