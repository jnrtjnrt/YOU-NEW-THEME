<div class="big-statement" style="min-height: 80vh; display: flex; flex-direction: column; justify-content: center; align-items: center;">
  {%- if section.settings.logo != blank -%}
    {%- liquid
      assign pw_logo = section.settings.logo
      assign pw_logo_height = 60
      assign pw_logo_width = pw_logo_height | times: pw_logo.aspect_ratio | round | at_least: 1
      assign pw_logo_width_2x = pw_logo_width | times: 2
      assign pw_logo_widths = pw_logo_width | append: ', ' | append: pw_logo_width_2x
      assign pw_logo_sizes = pw_logo_width | append: 'px'
      assign pw_logo_alt = pw_logo.alt | default: shop.name
    -%}
    {{ pw_logo | image_url: width: pw_logo_width_2x | image_tag:
      widths: pw_logo_widths,
      sizes: pw_logo_sizes,
      width: pw_logo_width,
      height: pw_logo_height,
      alt: pw_logo_alt,
      loading: 'eager',
      style: 'height: 60px; width: auto; max-width: 80vw; margin-bottom: 32px;' }}
  {%- else -%}
    <span class="header__logo-text" style="margin-bottom: 32px;">{{ shop.name }}</span>
  {%- endif -%}

  <h1 style="font-size: calc(64px * var(--heading-scale));">{{ section.settings.heading }}</h1>

  {%- if shop.password_message != blank -%}
    <p>{{ shop.password_message }}</p>
  {%- elsif section.settings.text != blank -%}
    <div>{{ section.settings.text }}</div>
  {%- endif -%}

  {% form 'storefront_password' %}
    {%- if form.errors -%}
      <p class="form-status form-status--error">{{ form.errors.messages['form'] }}</p>
    {%- endif -%}
    <div style="display: flex; gap: 12px; margin-top: 24px; flex-wrap: wrap; justify-content: center;">
      <input class="input" type="password" name="password" placeholder="{{ 'general.password_page.placeholder' | t }}" aria-label="{{ 'general.password_page.placeholder' | t }}">
      <button type="submit" class="button">{{ 'general.password_page.submit' | t }}</button>
    </div>
  {% endform %}
</div>

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something loud is coming." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We're not open yet. Come back soon.</p>" }
  ]
}
{% endschema %}
