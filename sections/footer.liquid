<footer class="footer" style="background: {{ settings.footer_background }}; color: {{ settings.footer_text }}; padding: {{ section.settings.padding_top }}px 0 32px 0;">
  <div class="container footer__columns" style="display: grid; grid-template-columns: 1.4fr repeat({{ section.blocks.size | at_most: 3 | at_least: 1 }}, 1fr); gap: 40px;">
    <div class="footer__brand" style="display: flex; flex-direction: column; gap: 16px;">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: height: 112 }}"
          alt="{{ shop.name | escape }}"
          style="height: 56px; width: auto; align-self: flex-start;"
          width="{{ section.settings.logo.width }}"
          height="56"
          loading="lazy">
      {%- else -%}
        <span class="header__logo-text" style="color: {{ settings.footer_text }};">{{ shop.name }}</span>
      {%- endif -%}
      {%- if section.settings.tagline != blank -%}
        <p style="color: var(--color-fg-muted); font-size: 13px; line-height: 1.6; max-width: 280px; margin: 0;">{{ section.settings.tagline }}</p>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      <div class="footer__column" style="display: flex; flex-direction: column; gap: 12px;" {{ block.shopify_attributes }}>
        {%- if block.settings.heading != blank -%}
          <span style="color: {{ settings.footer_heading }}; font-size: 12px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase;">{{ block.settings.heading }}</span>
        {%- endif -%}

        {%- case block.type -%}
          {%- when 'menu' -%}
            {%- for link in block.settings.menu.links -%}
              <a href="{{ link.url }}" style="color: {{ settings.footer_text }}; font-size: 14px;">{{ link.title }}</a>
            {%- endfor -%}
          {%- when 'social' -%}
            {%- if settings.social_facebook_label != blank -%}
              <a href="{{ settings.social_facebook_link | default: '#' }}" style="color: {{ settings.footer_text }}; font-size: 14px;">{{ settings.social_facebook_label }}</a>
            {%- endif -%}
            {%- if settings.social_instagram_label != blank -%}
              <a href="{{ settings.social_instagram_link | default: '#' }}" style="color: {{ settings.footer_text }}; font-size: 14px;">{{ settings.social_instagram_label }}</a>
            {%- endif -%}
            {%- if settings.social_tiktok_label != blank -%}
              <a href="{{ settings.social_tiktok_link | default: '#' }}" style="color: {{ settings.footer_text }}; font-size: 14px;">{{ settings.social_tiktok_label }}</a>
            {%- endif -%}
          {%- when 'text' -%}
            <div style="font-size: 14px; line-height: 1.6;">{{ block.settings.text }}</div>
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="container footer__bottom" style="margin-top: 48px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.18); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; color: var(--color-fg-muted); font-size: 12px;">
    <span>
      {%- if section.settings.copyright != blank -%}
        {{ section.settings.copyright }}
      {%- else -%}
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
      {%- endif -%}
    </span>
    {%- if section.settings.hashtags != blank -%}
      <span>{{ section.settings.hashtags }}</span>
    {%- endif -%}
  </div>
</footer>

<style>
  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .footer__columns { grid-template-columns: 1fr 1fr !important; }
  }
  @media (max-width: 599px) {
    #shopify-section-{{ section.id }} .footer__columns { grid-template-columns: 1fr !important; }
  }
</style>

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo",
      "info": "Use the light/white version of the wordmark."
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "A bag is more than something you wear — it's a part of your everyday story."
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright line",
      "info": "Leave blank for the automatic © year + store name."
    },
    {
      "type": "text",
      "id": "hashtags",
      "label": "Hashtags line",
      "default": "#MadeByYOU #YOUBags"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 128,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "social",
      "name": "Social links",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Follow" },
        { "type": "paragraph", "content": "Links and labels come from Theme settings > Social media." }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu" },
        { "type": "menu", "settings": { "heading": "Need Help?" } },
        { "type": "social" }
      ]
    }
  ]
}
{% endschema %}
