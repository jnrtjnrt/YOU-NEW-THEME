<div style="background: {{ section.settings.background }}; padding: {{ section.settings.padding }}px 0;">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading" style="color: {{ section.settings.heading_color }}; margin-bottom: 40px;">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="grid ugc__grid" style="grid-template-columns: repeat({{ section.settings.columns }}, 1fr); gap: 16px;">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tag_el = 'div'
          if block.settings.link != blank
            assign tag_el = 'a'
          endif
        -%}
        <{{ tag_el }}{% if block.settings.link != blank %} href="{{ block.settings.link }}"{% endif %} style="position: relative; aspect-ratio: 3/4; overflow: hidden; display: block;" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 420 }}"
              srcset="{{ block.settings.image | image_url: width: 420 }} 420w, {{ block.settings.image | image_url: width: 640 }} 640w"
              sizes="(min-width: 990px) 16vw, 50vw"
              alt="{{ block.settings.image.alt | default: block.settings.handle | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              style="width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0;">
          {%- else -%}
            <div style="position: absolute; inset: 0;">{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          {%- endif -%}
          {%- if block.settings.handle != blank or block.settings.caption != blank -%}
            <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 10px; background: rgba(26,26,26,0.75);">
              {%- if block.settings.handle != blank -%}
                <span style="color: {{ section.settings.handle_color }}; font-size: 11px; font-weight: 700; display: block;">{{ block.settings.handle }}</span>
              {%- endif -%}
              {%- if block.settings.caption != blank -%}
                <span style="color: {{ section.settings.caption_color }}; font-size: 11px;">{{ block.settings.caption }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        </{{ tag_el }}>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .ugc__grid { grid-template-columns: repeat(3, 1fr) !important; }
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} > div { padding: {{ section.settings.padding | times: 0.75 | round }}px 0 !important; }
    #shopify-section-{{ section.id }} .ugc__grid { gap: 8px !important; }
  }
  @media (max-width: 599px) {
    #shopify-section-{{ section.id }} .ugc__grid { grid-template-columns: repeat(2, 1fr) !important; }
  }
</style>

{% schema %}
{
  "name": "UGC gallery",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wearing It Better Than Us" },
    { "type": "color", "id": "background", "label": "Background", "default": "#1A1A1A" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#FDFEFF" },
    { "type": "color", "id": "handle_color", "label": "Handle color", "default": "#FDFEFF" },
    { "type": "color", "id": "caption_color", "label": "Caption color", "default": "#D4E84A" },
    { "type": "range", "id": "columns", "label": "Columns", "min": 3, "max": 6, "step": 1, "default": 6 },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 0, "max": 128, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "handle", "label": "Handle", "default": "@yourcustomer" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "wears VERSA in Rich Black" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "UGC gallery",
      "blocks": [
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" },
        { "type": "photo" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
