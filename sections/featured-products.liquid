<div style="padding: {{ section.settings.padding }}px 0;">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- liquid
      assign products_source = section.settings.collection.products
      assign limit = section.settings.products_count
    -%}

    {%- if section.settings.layout == 'carousel' -%}
      <div class="scroll-row">
        {%- if products_source.size > 0 -%}
          {%- for product in products_source limit: limit -%}
            {% render 'product-card', card_product: product, image_ratio: section.settings.image_ratio %}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <div class="product-card product-card--square">
              <div class="product-card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="grid grid--4">
        {%- if products_source.size > 0 -%}
          {%- for product in products_source limit: limit -%}
            {% render 'product-card', card_product: product, image_ratio: section.settings.image_ratio %}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <div class="product-card product-card--square">
              <div class="product-card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_view_all and section.settings.collection != blank -%}
      <div style="display: flex; justify-content: center; margin-top: 32px;">
        <a href="{{ section.settings.collection.url }}" class="link-underline">{{ section.settings.view_all_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured products",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Y'all Can't Stop Buying" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_count", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "carousel", "label": "Horizontal scroll" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "carousel"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "natural", "label": "Natural" }
      ],
      "default": "square"
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view-all link", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View-all label", "default": "VIEW ALL →" },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 0, "max": 128, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [
    { "name": "Featured products" }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
