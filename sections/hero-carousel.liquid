<div
  class="hero"
  data-hero-carousel
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed }}"
  style="position: relative; width: 100%; height: {{ section.settings.height }}px; overflow: hidden;">

  {%- for block in section.blocks -%}
    <div
      class="hero__slide{% if forloop.first %} is-active{% endif %}"
      data-hero-slide
      aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
      style="position: absolute; inset: 0; opacity: {% if forloop.first %}1{% else %}0{% endif %}; transition: opacity 400ms var(--ease-snap);"
      {{ block.shopify_attributes }}>

      {%- if block.settings.image != blank -%}
        {%- liquid
          assign desktop_image = block.settings.image
          assign mobile_image = block.settings.mobile_image | default: desktop_image
        -%}
        <picture>
          {%- if block.settings.mobile_image != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="{{ mobile_image | image_url: width: 375 }} 375w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1100 }} 1100w"
              sizes="100vw">
          {%- endif -%}
          <img
            class="hero__image{% if block.settings.mobile_image != blank %} hero__image--has-mobile{% endif %}"
            srcset="{{ desktop_image | image_url: width: 750 }} 750w, {{ desktop_image | image_url: width: 1500 }} 1500w, {{ desktop_image | image_url: width: 2200 }} 2200w"
            src="{{ desktop_image | image_url: width: 1500 }}"
            sizes="100vw"
            alt="{{ desktop_image.alt | default: block.settings.heading | escape }}"
            {% if forloop.first %}fetchpriority="high" loading="eager"{% else %}loading="lazy"{% endif %}
            width="{{ desktop_image.width }}"
            height="{{ desktop_image.height }}"
            style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: {{ desktop_image.presentation.focal_point | default: 'center center' }};">
        </picture>
      {%- else -%}
        <div style="position: absolute; inset: 0; background: {{ block.settings.fallback_color }};"></div>
      {%- endif -%}

      <div class="hero__content" style="position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; padding: 48px var(--gutter); background: linear-gradient(0deg, rgba(26,26,26,{{ section.settings.overlay_opacity | divided_by: 100.0 }}) 0%, rgba(26,26,26,{{ section.settings.overlay_opacity | divided_by: 100.0 | times: 0.65 }}) 60%, rgba(26,26,26,0) 100%);">
        {%- if block.settings.eyebrow != blank -%}
          <span class="eyebrow" style="color: {{ block.settings.text_color }}; margin-bottom: 6px;">{{ block.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if block.settings.heading != blank -%}
          <h2 class="hero__heading" style="color: {{ block.settings.text_color }}; margin: 0 0 20px 0; max-width: 900px;">
            {{- block.settings.heading -}}
            {%- if block.settings.heading_accent != blank -%}
              <span style="color: {{ block.settings.accent_color }}; font-style: italic;"> {{ block.settings.heading_accent }}</span>
            {%- endif -%}
          </h2>
        {%- endif -%}
        {%- if block.settings.button_label != blank -%}
          <div class="hero__cta">
            <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="button">{{ block.settings.button_label }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}

  {%- if section.settings.show_dots and section.blocks.size > 1 -%}
    <div class="hero__dots" style="position: absolute; bottom: 24px; right: var(--gutter); display: flex; gap: 10px; z-index: 2;">
      {%- for block in section.blocks -%}
        <button
          type="button"
          data-hero-dot
          class="hero__dot{% if forloop.first %} is-active{% endif %}"
          aria-label="{{ 'sections.hero.go_to_slide' | t: number: forloop.index }}"
          style="width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--color-fg-inverse); background: transparent; cursor: pointer; padding: 0;"></button>
      {%- endfor -%}
    </div>
    <style>
      #shopify-section-{{ section.id }} .hero__dot.is-active { background: var(--color-fg-inverse) !important; }
    </style>
  {%- endif -%}
</div>

<style>
  #shopify-section-{{ section.id }} .hero__heading {
    /* Fluid type: tracks the section's headline-size setting on desktop and
       scales down smoothly with the viewport instead of jumping at breakpoints. */
    font-size: clamp(28px, calc(24px + 4.2vw), calc({{ section.settings.heading_size }}px * var(--heading-scale)));
    line-height: 1.1;
    overflow-wrap: break-word;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .hero {
      height: {{ section.settings.mobile_height }}px !important;
      max-height: 82svh;
    }
    #shopify-section-{{ section.id }} .hero__content {
      padding: 20px var(--gutter) 28px var(--gutter) !important;
    }
    #shopify-section-{{ section.id }} .hero__heading { margin-bottom: 14px !important; }
    #shopify-section-{{ section.id }} .hero .eyebrow { letter-spacing: 0.2em; font-size: 11px; }
    {%- if section.settings.show_dots and section.blocks.size > 1 -%}
    /* Reserve a clear lane for the dots below the CTA. */
    #shopify-section-{{ section.id }} .hero__content { padding-bottom: 56px !important; }
    #shopify-section-{{ section.id }} .hero__dots {
      left: 50% !important; right: auto !important; transform: translateX(-50%);
      bottom: 18px !important;
    }
    {%- endif -%}
  }
  @media (max-width: 479px) {
    #shopify-section-{{ section.id }} .hero__cta .button { width: 100%; }
  }
</style>

{% schema %}
{
  "name": "Hero carousel",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "height",
      "label": "Height (desktop)",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Height (mobile)",
      "min": 320,
      "max": 640,
      "step": 20,
      "unit": "px",
      "default": 480,
      "info": "Capped at 82% of the screen so the headline and button always stay above the fold."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Headline size (desktop)",
      "min": 40,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 76,
      "info": "On smaller screens the headline scales fluidly with the viewport."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay darkness",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 85
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Change slides every",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show navigation dots",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Set the image's focal point in the Shopify admin media editor — the hero crops around it on every screen size." },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (optional)", "info": "A portrait crop shown on screens under 750px. Falls back to the main image." },
        { "type": "color", "id": "fallback_color", "label": "Background color (no image)", "default": "#1A1A1A" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made By YOU" },
        { "type": "text", "id": "heading", "label": "Headline", "default": "Unapologetically" },
        { "type": "text", "id": "heading_accent", "label": "Accented word", "default": "you.", "info": "Rendered italic in the accent color after the headline." },
        { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#D4E84A" },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#FDFEFF" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "GO OFF THEN" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Hero carousel",
      "blocks": [
        { "type": "slide" },
        { "type": "slide", "settings": { "eyebrow": "New", "heading": "Zero effort, all drip.", "heading_accent": "", "button_label": "TAKE MY MONEY" } },
        { "type": "slide", "settings": { "eyebrow": "Mix & Match", "heading": "Straps for every mood.", "heading_accent": "", "button_label": "I GUESS I'LL LOOK" } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
