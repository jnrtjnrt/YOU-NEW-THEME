<div class="container" style="padding-top: 48px; padding-bottom: 64px;">
  <h1 class="page-title">{{ 'general.search.title' | t }}</h1>

  <form action="{{ routes.search_url }}" method="get" role="search" style="display: flex; gap: 12px; max-width: 640px; margin: 0 auto 48px auto;">
    <input class="input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.title' | t }}" style="flex: 1;">
    <input type="hidden" name="options[prefix]" value="last">
    <button type="submit" class="button">{{ 'general.search.submit' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <p class="section-subtext">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
    {%- else -%}
      <p class="section-subtext" style="margin-bottom: 32px;">{{ 'general.search.results_count' | t: count: search.results_count, terms: search.terms }}</p>

      {%- paginate search.results by section.settings.results_per_page -%}
        <div class="grid grid--4">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', card_product: item %}
            {%- else -%}
              <a href="{{ item.url }}" class="article-card">
                <span class="article-card__meta">
                  {%- if item.object_type == 'article' -%}{{ 'general.search.type_article' | t }}{%- else -%}{{ 'general.search.type_page' | t }}{%- endif -%}
                </span>
                <h2 class="article-card__title">{{ item.title }}</h2>
                {%- if item.content -%}
                  <p class="article-card__excerpt">{{ item.content | strip_html | truncate: 120 }}</p>
                {%- endif -%}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search results",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "results_per_page", "label": "Results per page", "min": 8, "max": 48, "step": 4, "default": 16 }
  ]
}
{% endschema %}
