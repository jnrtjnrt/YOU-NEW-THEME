<div style="background: {{ section.settings.background }}; color: {{ section.settings.text_color }}; padding: {{ section.settings.padding }}px 0;">
  <div class="container" style="text-align: center;">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 style="font-size: calc(48px * var(--heading-scale)); margin: 4px 0 0 0;">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div style="font-size: 16px; max-width: 560px; margin: 16px auto 0 auto;">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="grid how-it-works__steps" style="grid-template-columns: repeat({{ section.blocks.size | at_most: 4 }}, 1fr); gap: 24px; margin-top: 32px; text-align: left;">
        {%- for block in section.blocks -%}
          <div style="display: flex; flex-direction: column; gap: 12px;" {{ block.shopify_attributes }}>
            <span style="font-family: var(--font-display); font-weight: 700; font-size: 32px;">{{ block.settings.number | default: forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {%- if block.settings.title != blank -%}
              <h3 style="font-size: calc(24px * var(--heading-scale)); margin: 0;">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div style="font-size: 14px; line-height: 1.5; margin: 0;">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div style="display: flex; justify-content: center; margin-top: 40px;">
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="button button--primary">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .how-it-works__steps { grid-template-columns: 1fr !important; gap: 28px !important; }
    #shopify-section-{{ section.id }} h2 { font-size: clamp(24px, calc(15px + 4vw), calc(32px * var(--heading-scale))) !important; }
    #shopify-section-{{ section.id }} > div { padding: {{ section.settings.padding | times: 0.75 | round }}px 0 !important; }
  }
</style>

{% schema %}
{
  "name": "Steps / how it works",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#D4E84A" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1A1A1A" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "HEADS UP" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bags and straps come separate." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Mix and match so you're never stuck with one look. Too lazy to pick two things yourself? Grab a bundle, we did it for you.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "JUST GIVE ME A BUNDLE" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 0, "max": 128, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "info": "Leave blank to number automatically." },
        { "type": "text", "id": "title", "label": "Title", "default": "Pick a bag" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every bag is sold on its own, so it doesn't come with a strap you'll never use.</p>" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Steps / how it works",
      "blocks": [
        { "type": "step" },
        { "type": "step", "settings": { "title": "Pick a strap", "text": "<p>Swap it whenever you're bored. Different mood, different strap, same bag.</p>" } },
        { "type": "step", "settings": { "title": "Or skip the thinking", "text": "<p>Grab a bundle. We already matched a bag and strap so you don't have to.</p>" } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
