<div class="container" style="padding-top: 32px; padding-bottom: 48px;">
  <div class="product">

    {%- comment -%} GALLERY {%- endcomment -%}
    <div data-product-gallery>
      <div class="product__gallery-main">
        {%- assign featured = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}
        {%- if featured -%}
          <img
            data-gallery-main
            src="{{ featured | image_url: width: 1200 }}"
            srcset="{{ featured | image_url: width: 750 }} 750w, {{ featured | image_url: width: 1200 }} 1200w, {{ featured | image_url: width: 1600 }} 1600w"
            sizes="(min-width: 990px) 55vw, 100vw"
            alt="{{ featured.alt | escape }}"
            loading="eager"
            width="{{ featured.width }}"
            height="{{ featured.height }}">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}

        {%- if product.media.size > 1 and section.settings.show_gallery_arrows -%}
          <button type="button" class="product__gallery-arrow product__gallery-arrow--prev" data-gallery-prev aria-label="{{ 'products.product.previous_image' | t }}">{% render 'icon', icon: 'arrow-left', size: 18 %}</button>
          <button type="button" class="product__gallery-arrow product__gallery-arrow--next" data-gallery-next aria-label="{{ 'products.product.next_image' | t }}">{% render 'icon', icon: 'arrow-right', size: 18 %}</button>
        {%- endif -%}
      </div>

      {%- if product.media.size > 1 and section.settings.show_thumbnails -%}
        <div class="product__thumbs">
          {%- for media in product.media -%}
            <button
              type="button"
              class="product__thumb{% if media.id == featured.id %} is-active{% endif %}"
              data-gallery-thumb
              data-media-id="{{ media.id }}"
              data-full-src="{{ media | image_url: width: 1200 }}"
              data-full-srcset="{{ media | image_url: width: 750 }} 750w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1600 }} 1600w"
              aria-label="{{ 'products.product.view_image' | t: number: forloop.index }}">
              <img src="{{ media | image_url: width: 144 }}" alt="{{ media.alt | escape }}" width="72" height="72" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} INFO {%- endcomment -%}
    <div data-product-info>
      {%- assign current_variant = product.selected_or_first_available_variant -%}

      {%- form 'product', product, data-product-form: '' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}">

        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'eyebrow' -%}
              <span class="product__eyebrow" style="color: {{ block.settings.color }};" {{ block.shopify_attributes }}>
                {%- if block.settings.text != blank -%}
                  {{ block.settings.text }}
                {%- elsif product.collections.first -%}
                  {{ product.collections.first.title }}
                {%- else -%}
                  {{ product.type }}
                {%- endif -%}
              </span>

            {%- when 'title' -%}
              <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

            {%- when 'rating' -%}
              {%- if product.metafields.reviews.rating.value != blank -%}
                <div class="product__rating" {{ block.shopify_attributes }}>
                  <span class="product__stars" aria-hidden="true">★★★★★</span>
                  <span class="product__rating-count">
                    {{ product.metafields.reviews.rating.value }} ·
                    {{ 'products.product.reviews_count' | t: count: product.metafields.reviews.rating_count.value | default: 0 }}
                  </span>
                </div>
              {%- elsif block.settings.placeholder_text != blank -%}
                <div class="product__rating" {{ block.shopify_attributes }}>
                  <span class="product__stars" aria-hidden="true">★★★★★</span>
                  <span class="product__rating-count">{{ block.settings.placeholder_text }}</span>
                </div>
              {%- endif -%}

            {%- when 'price' -%}
              <div class="product__price" data-product-price {{ block.shopify_attributes }}>
                {% render 'price', variant: current_variant %}
              </div>

            {%- when 'divider' -%}
              <hr class="product__divider" {{ block.shopify_attributes }}>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div data-variant-picker {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    {%- liquid
                      assign opt_name = option.name | downcase
                      assign is_color = false
                      if opt_name == 'color' or opt_name == 'colour'
                        assign is_color = true
                      endif
                    -%}
                    <fieldset style="border: none; padding: 0; margin: 0 0 24px 0;">
                      <legend style="padding: 0;">
                        <span class="product__option-label">{{ option.name }}</span>
                        <span class="product__option-value" data-option-selected>{{ option.selected_value }}</span>
                      </legend>
                      <div class="{% if is_color and block.settings.color_swatches %}product__swatches{% else %}option-pills{% endif %}">
                        {%- for value in option.values -%}
                          {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
                          <input
                            type="radio"
                            class="swatch-input"
                            id="{{ input_id }}"
                            name="{{ section.id }}-option-{{ option.position }}"
                            value="{{ value | escape }}"
                            {% if option.selected_value == value %}checked{% endif %}>
                          {%- if is_color and block.settings.color_swatches -%}
                            {%- capture swatch_bg %}{% render 'swatch-color', value: value %}{% endcapture -%}
                            <label class="swatch-label" for="{{ input_id }}" style="background: {{ swatch_bg | strip }};" title="{{ value | escape }}">
                              <span class="visually-hidden">{{ value }}</span>
                            </label>
                          {%- else -%}
                            <label class="option-pill-label" for="{{ input_id }}">{{ value }}</label>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                </div>
              {%- endunless -%}

            {%- when 'quantity' -%}
              <div class="product__qty-row" {{ block.shopify_attributes }}>
                <span class="product__option-label">{{ 'products.product.quantity' | t }}</span>
                <div class="qty">
                  <button type="button" class="qty__button" data-qty-change="-1" aria-label="{{ 'products.product.decrease_quantity' | t }}">{% render 'icon', icon: 'minus', size: 14 %}</button>
                  <input class="qty__input" type="number" name="quantity" value="1" min="1" aria-label="{{ 'products.product.quantity' | t }}">
                  <button type="button" class="qty__button" data-qty-change="1" aria-label="{{ 'products.product.increase_quantity' | t }}">{% render 'icon', icon: 'plus', size: 14 %}</button>
                </div>
              </div>

            {%- when 'buy_buttons' -%}
              <div class="product__buttons" {{ block.shopify_attributes }}>
                <button
                  type="submit"
                  name="add"
                  class="button"
                  {% unless current_variant.available %}disabled{% endunless %}>
                  {%- if current_variant.available -%}
                    {{ 'products.product.add_to_cart' | t }}
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </button>
                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
              </div>
              <p class="form-status form-status--error" data-form-status hidden style="margin-top: 16px;"></p>

            {%- when 'trust_badges' -%}
              <div class="product__trust" {{ block.shopify_attributes }}>
                {%- if block.settings.item_1 != blank -%}
                  <div class="product__trust-item">{% render 'icon', icon: 'shipping', size: 18 %}<span>{{ block.settings.item_1 }}</span></div>
                {%- endif -%}
                {%- if block.settings.item_2 != blank -%}
                  <div class="product__trust-item">{% render 'icon', icon: 'returns', size: 18 %}<span>{{ block.settings.item_2 }}</span></div>
                {%- endif -%}
                {%- if block.settings.item_3 != blank -%}
                  <div class="product__trust-item">{% render 'icon', icon: 'secure', size: 18 %}<span>{{ block.settings.item_3 }}</span></div>
                {%- endif -%}
                {%- if block.settings.item_4 != blank -%}
                  <div class="product__trust-item">{% render 'icon', icon: 'warranty', size: 18 %}<span>{{ block.settings.item_4 }}</span></div>
                {%- endif -%}
              </div>

            {%- when 'collapsible_tab' -%}
              <details class="accordion" {% if block.settings.open_by_default %}open{% endif %} {{ block.shopify_attributes }}>
                <summary>
                  <span>{{ block.settings.heading }}</span>
                  <span class="accordion__chevron">{% render 'icon', icon: 'chevron', size: 16 %}</span>
                </summary>
                <div class="accordion__content">
                  {%- if block.settings.use_description -%}
                    {{ product.description }}
                  {%- else -%}
                    {{ block.settings.content }}
                    {%- if block.settings.page != blank -%}
                      {{ block.settings.page.content }}
                    {%- endif -%}
                  {%- endif -%}
                </div>
              </details>

            {%- when 'text' -%}
              <div class="rte" style="max-width: none; margin: 16px 0;" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- endcase -%}
        {%- endfor -%}
      {%- endform -%}
    </div>
  </div>
</div>

{%- comment -%} Sticky add-to-cart bar {%- endcomment -%}
{%- if section.settings.enable_sticky_atc -%}
  <div class="sticky-atc" data-sticky-atc>
    <div class="sticky-atc__inner">
      <div class="sticky-atc__product">
        {%- if product.featured_media -%}
          <img class="sticky-atc__image" src="{{ product.featured_media | image_url: width: 96 }}" alt="{{ product.featured_media.alt | escape }}" width="48" height="48" loading="lazy">
        {%- endif -%}
        <div style="min-width: 0;">
          <div class="sticky-atc__title">{{ product.title }}</div>
          <div class="sticky-atc__price" data-sticky-price>{{ current_variant.price | money }}</div>
        </div>
      </div>
      <button type="button" class="button button--md" data-sticky-add onclick="document.querySelector('form[data-product-form] [name=add]').click()" {% unless current_variant.available %}disabled{% endunless %}>
        {{ 'products.product.add_to_cart' | t }}
      </button>
    </div>
  </div>
{%- endif -%}

{%- comment -%} Variant data for the picker JS {%- endcomment -%}
<script type="application/json" data-variant-json>
  [
    {%- for variant in product.variants -%}
      {
        "id": {{ variant.id }},
        "available": {{ variant.available }},
        "options": {{ variant.options | json }},
        "price_formatted": {{ variant.price | money | json }},
        "featured_media_id": {{ variant.featured_media.id | json }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
</script>

{% schema %}
{
  "name": "Product page",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Gallery" },
    { "type": "checkbox", "id": "show_thumbnails", "label": "Show thumbnails", "default": true },
    { "type": "checkbox", "id": "show_gallery_arrows", "label": "Show arrows", "default": true },
    { "type": "header", "content": "Behaviour" },
    { "type": "checkbox", "id": "enable_sticky_atc", "label": "Sticky add-to-cart bar", "default": true }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Category eyebrow",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text override", "info": "Defaults to the product's first collection." },
        { "type": "color", "id": "color", "label": "Color", "default": "#E8401C" }
      ]
    },
    { "type": "title", "name": "Title", "limit": 1 },
    {
      "type": "rating",
      "name": "Star rating",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Shows the reviews.rating metafield when a review app is installed." },
        { "type": "text", "id": "placeholder_text", "label": "Fallback text", "info": "Shown when no rating metafield exists. Leave blank to hide." }
      ]
    },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "divider", "name": "Divider" },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "color_swatches", "label": "Show color options as swatches", "default": true, "info": "Swatch colors come from Theme settings > Product cards." }
      ]
    },
    { "type": "quantity", "name": "Quantity selector", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout button", "default": true }
      ]
    },
    {
      "type": "trust_badges",
      "name": "Trust badges",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "item_1", "label": "Item 1 (shipping)", "default": "Free shipping over ₱2,000" },
        { "type": "text", "id": "item_2", "label": "Item 2 (returns)", "default": "7-day easy returns" },
        { "type": "text", "id": "item_3", "label": "Item 3 (secure)", "default": "Secure checkout" },
        { "type": "text", "id": "item_4", "label": "Item 4 (warranty)", "default": "6-month warranty" }
      ]
    },
    {
      "type": "collapsible_tab",
      "name": "Collapsible tab",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Description" },
        { "type": "checkbox", "id": "use_description", "label": "Show product description", "default": false },
        { "type": "richtext", "id": "content", "label": "Content" },
        { "type": "page", "id": "page", "label": "Content from page" },
        { "type": "checkbox", "id": "open_by_default", "label": "Open by default", "default": false }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ]
}
{% endschema %}
