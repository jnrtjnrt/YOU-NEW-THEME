{% comment %}
  "Don't feel like picking?" row of staff-picked bag+strap pairings. Each
  block references a bag and a strap product; clicking "Use this set" jumps
  the Style Lab builder above to that exact pairing (matched by product ID)
  rather than adding a separate bundle SKU — mirrors the source behavior of
  applying a staff pick directly to the two pickers.
{% endcomment %}
{%- if section.blocks.size > 0 -%}
  <div style="background: {{ section.settings.background }}; padding: {{ section.settings.padding }}px 0;">
    <div class="container">
      {%- if section.settings.heading != blank -%}
        <h2 class="section-heading" style="color: {{ section.settings.text_color }}; margin-bottom: 8px;">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="section-subtext" style="color: {{ section.settings.text_color }}; margin-bottom: 32px;">{{ section.settings.subheading }}</p>
      {%- endif -%}

      <div class="style-lab-sets__row-wrap">
        <div class="style-lab-sets__row" data-style-lab-sets-scroll>
          {%- for block in section.blocks -%}
            {%- liquid
              assign bag = block.settings.bag_product
              assign strap = block.settings.strap_product
            -%}
            {%- if bag != blank and strap != blank -%}
              {%- assign total_price = bag.price | plus: strap.price -%}
              <div class="style-lab-set-card" data-style-lab-set data-bag-id="{{ bag.id }}" data-strap-id="{{ strap.id }}" {{ block.shopify_attributes }}>
                {%- if bag.featured_media -%}
                  <img src="{{ bag.featured_media | image_url: width: 440 }}" alt="{{ bag.title | escape }}" loading="lazy" width="{{ bag.featured_media.width }}" height="{{ bag.featured_media.height }}">
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
                <div class="style-lab-set-card__name">
                  {{ block.settings.name_override | default: bag.title | append: ' + ' | append: strap.title }}
                </div>
                <div class="style-lab-set-card__price">{{ total_price | money }}</div>
                <button type="button" class="button button--md" data-style-lab-use-set>{{ section.settings.use_set_label }}</button>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <button type="button" class="style-lab-sets__arrow style-lab-sets__arrow--prev" data-style-lab-sets-prev aria-label="{{ 'general.pagination.previous' | t }}">{% render 'icon', icon: 'arrow-left', size: 18 %}</button>
        <button type="button" class="style-lab-sets__arrow style-lab-sets__arrow--next" data-style-lab-sets-next aria-label="{{ 'general.pagination.next' | t }}">{% render 'icon', icon: 'arrow-right', size: 18 %}</button>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Style Lab bundled sets",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Don't Feel Like Picking?" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Already-matched sets. Just say yes." },
    { "type": "text", "id": "use_set_label", "label": "Button label", "default": "USE THIS SET" },
    { "type": "color", "id": "background", "label": "Background", "default": "#D4E84A" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1A1A1A" },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 0, "max": 128, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "set",
      "name": "Bag + strap pairing",
      "settings": [
        { "type": "product", "id": "bag_product", "label": "Bag" },
        { "type": "product", "id": "strap_product", "label": "Strap" },
        { "type": "text", "id": "name_override", "label": "Name override", "info": "Defaults to \"[Bag] + [Strap]\"." }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    { "name": "Style Lab bundled sets" }
  ]
}
{% endschema %}
