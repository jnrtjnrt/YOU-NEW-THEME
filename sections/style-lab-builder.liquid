{% comment %}
  Interactive "build your set" widget: cycle through a bag collection and a
  strap collection, pick a color for each, see a running total, add both to
  the cart in one action. Product data for the pickers is embedded as JSON
  and driven entirely by client-side JS — no hardcoded products.
{% endcomment %}
{%- liquid
  assign bag_products = section.settings.bags_collection.products
  assign strap_products = section.settings.straps_collection.products
-%}

<section class="style-lab-builder" data-style-lab-builder>
  <div class="container">
    <div class="grid style-lab-builder__grid" style="grid-template-columns: 1fr 1fr;">

      {%- comment %} BAG PICKER {%- endcomment %}
      <div class="style-lab-picker" data-style-lab-picker="bag" hidden>
        <div class="style-lab-picker__label">{{ section.settings.bag_label }}</div>
        <div class="style-lab-picker__media">
          <img data-style-lab-image alt="" width="600" height="750">
          <button type="button" class="style-lab-picker__arrow style-lab-picker__arrow--prev" data-style-lab-prev aria-label="{{ 'general.pagination.previous' | t }}">{% render 'icon', icon: 'arrow-left', size: 16 %}</button>
          <button type="button" class="style-lab-picker__arrow style-lab-picker__arrow--next" data-style-lab-next aria-label="{{ 'general.pagination.next' | t }}">{% render 'icon', icon: 'arrow-right', size: 16 %}</button>
        </div>
        <div class="style-lab-picker__info">
          <div class="style-lab-picker__name" data-style-lab-name></div>
          <div class="style-lab-picker__price" data-style-lab-price></div>
          <div class="style-lab-picker__swatches" data-style-lab-swatches></div>
        </div>
        <script type="application/json" data-style-lab-data>
          [
            {%- for p in bag_products limit: section.settings.max_products -%}
              {%- render 'style-lab-product-json', for_product: p -%}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        </script>
      </div>

      {%- comment %} STRAP PICKER {%- endcomment %}
      <div class="style-lab-picker" data-style-lab-picker="strap" hidden>
        <div class="style-lab-picker__label">{{ section.settings.strap_label }}</div>
        <div class="style-lab-picker__media">
          <img data-style-lab-image alt="" width="600" height="750">
          <button type="button" class="style-lab-picker__arrow style-lab-picker__arrow--prev" data-style-lab-prev aria-label="{{ 'general.pagination.previous' | t }}">{% render 'icon', icon: 'arrow-left', size: 16 %}</button>
          <button type="button" class="style-lab-picker__arrow style-lab-picker__arrow--next" data-style-lab-next aria-label="{{ 'general.pagination.next' | t }}">{% render 'icon', icon: 'arrow-right', size: 16 %}</button>
        </div>
        <div class="style-lab-picker__info">
          <div class="style-lab-picker__name" data-style-lab-name></div>
          <div class="style-lab-picker__price" data-style-lab-price></div>
          <div class="style-lab-picker__swatches" data-style-lab-swatches></div>
        </div>
        <script type="application/json" data-style-lab-data>
          [
            {%- for p in strap_products limit: section.settings.max_products -%}
              {%- render 'style-lab-product-json', for_product: p -%}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        </script>
      </div>
    </div>

    {%- if bag_products.size == 0 or strap_products.size == 0 -%}
      <p class="style-lab-builder__empty">{{ 'sections.style_lab.no_products' | t }}</p>
    {%- endif -%}
  </div>

  <div class="style-lab-summary" data-style-lab-summary hidden>
    <div class="container style-lab-summary__inner">
      <div class="style-lab-summary__images">
        <img data-style-lab-summary-image="bag" alt="" width="56" height="56">
        <span class="style-lab-summary__plus">+</span>
        <img data-style-lab-summary-image="strap" alt="" width="56" height="56">
      </div>
      <div class="style-lab-summary__text">
        <div class="style-lab-summary__name" data-style-lab-summary-name></div>
        <div class="style-lab-summary__total" data-style-lab-summary-total></div>
      </div>
      <button type="button" class="button" data-style-lab-add-set>{{ section.settings.add_set_label }}</button>
    </div>
  </div>
</section>

<style>
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .style-lab-builder__grid { grid-template-columns: 1fr !important; }
  }
</style>

{% schema %}
{
  "name": "Style Lab builder",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Pick the collections shoppers can mix and match. Each product needs a Color option for swatches to work; products without one still work, just without a color picker." },
    { "type": "collection", "id": "bags_collection", "label": "Bags collection" },
    { "type": "collection", "id": "straps_collection", "label": "Straps collection" },
    { "type": "range", "id": "max_products", "label": "Max products per picker", "min": 2, "max": 20, "step": 1, "default": 8 },
    { "type": "text", "id": "bag_label", "label": "Bag picker label", "default": "Choose Your Bag" },
    { "type": "text", "id": "strap_label", "label": "Strap picker label", "default": "Choose Your Strap" },
    { "type": "text", "id": "add_set_label", "label": "Add-set button label", "default": "ADD SET TO CART" }
  ],
  "presets": [
    { "name": "Style Lab builder" }
  ]
}
{% endschema %}
