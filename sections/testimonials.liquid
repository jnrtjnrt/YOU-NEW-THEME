<div style="background: {{ section.settings.background }}; padding: {{ section.settings.padding }}px 0;">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading" style="color: {{ section.settings.heading_color }}; margin-bottom: 40px;">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="grid testimonials__grid" style="grid-template-columns: repeat({{ section.settings.columns }}, 1fr);">
      {%- for block in section.blocks -%}
        <div style="background: {{ section.settings.card_background }}; color: {{ section.settings.card_text_color }}; padding: 24px; display: flex; flex-direction: column; gap: 16px;" {{ block.shopify_attributes }}>
          {%- if section.settings.show_stars -%}
            <span aria-hidden="true" style="color: var(--color-accent-warm); font-size: 13px; letter-spacing: 2px;">★★★★★</span>
          {%- endif -%}
          {%- if block.settings.quote != blank -%}
            <div style="font-size: 15px; line-height: 1.5; flex: 1;">{{ block.settings.quote }}</div>
          {%- endif -%}
          <div style="display: flex; flex-direction: column; gap: 2px;">
            {%- if block.settings.author != blank -%}
              <span style="font-weight: 700; font-size: 13px;">{{ block.settings.author }}</span>
            {%- endif -%}
            {%- if block.settings.label != blank -%}
              <span style="font-size: 12px; color: var(--color-fg-muted);">{{ block.settings.label }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .testimonials__grid { grid-template-columns: 1fr 1fr !important; }
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} > div { padding: {{ section.settings.padding | times: 0.75 | round }}px 0 !important; }
  }
  @media (max-width: 599px) {
    #shopify-section-{{ section.id }} .testimonials__grid { grid-template-columns: 1fr !important; }
  }
</style>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "They Won't Shut Up About It" },
    { "type": "color", "id": "background", "label": "Background", "default": "#E535AB" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#1A1A1A" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#FDFEFF" },
    { "type": "color", "id": "card_text_color", "label": "Card text color", "default": "#1A1A1A" },
    { "type": "checkbox", "id": "show_stars", "label": "Show stars", "default": false },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "range", "id": "padding", "label": "Vertical padding", "min": 0, "max": 128, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "richtext", "id": "quote", "label": "Quote", "default": "<p>Write a real customer review here.</p>" },
        { "type": "text", "id": "author", "label": "Author", "default": "a*****n" },
        { "type": "text", "id": "label", "label": "Sub-label", "default": "Verified Buyer" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "review" },
        { "type": "review", "settings": { "author": "j*****v" } },
        { "type": "review", "settings": { "author": "m*****z" } },
        { "type": "review", "settings": { "author": "r*****t" } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
