{% comment %}
  Reusable legal/policy page layout: title band + auto-generated sticky
  table of contents + rich-text body. The TOC is built client-side from
  whatever <h2> headings exist in the page's content (Heading 2 style in
  the page editor), so this works for Terms, Refund Policy, Privacy,
  FAQ, or any other long-form page without hardcoding section names here.
{% endcomment %}
<section class="legal-hero">
  {%- if section.settings.eyebrow != blank -%}
    <span class="eyebrow" style="color: {{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow }}</span>
  {%- endif -%}
  <h1 class="legal-hero__title">{{ section.settings.heading | default: page.title }}</h1>
  {%- if section.settings.show_last_updated -%}
    <p class="legal-hero__updated">
      {%- if section.settings.last_updated_override != blank -%}
        {{ section.settings.last_updated_override }}
      {%- else -%}
        {{ 'general.legal.last_updated' | t: date: page.updated_at | date: format: 'abbreviated_date' }}
      {%- endif -%}
    </p>
  {%- endif -%}
</section>

<section class="legal-grid" data-legal-grid>
  <aside class="legal-toc" data-legal-toc hidden>
    <span class="legal-toc__label">{{ 'general.legal.on_this_page' | t }}</span>
    <nav class="legal-toc__nav" data-legal-toc-nav aria-label="{{ 'general.legal.on_this_page' | t }}"></nav>
  </aside>

  <div class="legal-body rte" data-legal-body>
    {{ page.content }}
  </div>
</section>

{% schema %}
{
  "name": "Legal page content",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Need Help?" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow color", "default": "#E8401C" },
    { "type": "text", "id": "heading", "label": "Heading override", "info": "Defaults to the page's own title." },
    { "type": "checkbox", "id": "show_last_updated", "label": "Show last-updated date", "default": true },
    { "type": "text", "id": "last_updated_override", "label": "Last-updated text override", "info": "Defaults to the page's last-saved date." }
  ]
}
{% endschema %}
